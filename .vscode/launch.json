{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run full pipeline (data → model → policy simulation)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "2. Start decision API (FastAPI, http://127.0.0.1:8000/docs)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["scooler.service:app", "--app-dir", "src", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "jinja": true
    },
    {
      "name": "3. Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
